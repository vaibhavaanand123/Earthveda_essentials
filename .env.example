# Copy to .env. Never commit this file after adding secrets.
NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/earthveda.sqlite
PUBLIC_SITE_URL=http://localhost:5173
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Checkout is off until provider setup and approved seller/product information exist.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# A verified Resend sender is required for customer receipts and team alerts.
RESEND_API_KEY=
EMAIL_FROM=
TEAM_EMAIL=
# Bootstrap the first owner once. At least 14 characters; remove after first successful login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional WhatsApp Cloud API. Approved utility template has 4 body parameters:
# first name, order number, status, formatted total.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=earthveda_order_update
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0
TEAM_WHATSAPP=
TEAM_WHATSAPP_OPT_IN=false
# 0 for direct development; exactly 1 behind the included Caddy proxy.
TRUST_PROXY=0
ORDER_RATE_LIMIT=10
LOG_LEVEL=info
